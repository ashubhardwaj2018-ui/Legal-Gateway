# ─────────────────────────────────────────────────────────────────────────────
# Legal Filing India — Environment Variables Reference
# Copy this file to .env and fill in your values before deploying.
# All variables marked REQUIRED must be set. OPTIONAL ones have safe defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production                   # REQUIRED — set to "production"
PORT=8080                             # REQUIRED — port the API server listens on
APP_URL=https://legalfilingindia.com  # REQUIRED — public URL of the site (no trailing slash).
                                      # Controls CORS: in production only this domain (+ www.) can
                                      # call the API. Replit preview domains are excluded in production.
CORS_EXTRA_ORIGINS=                   # OPTIONAL — comma-separated exact origin URLs allowed in addition
                                      # to APP_URL. Use for staging domains, e.g.:
                                      # CORS_EXTRA_ORIGINS=https://staging.legalfilingindia.com

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Provide either DATABASE_URL (full connection string) OR individual fields.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=legalfiling
# DB_USER=postgres
# DB_PASSWORD=

# ── Session / Auth ────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string   # REQUIRED — min 32 chars, used for cookie signing

# ── SMTP (Email) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com              # REQUIRED for email — your SMTP server
SMTP_PORT=587                         # REQUIRED — 587 (STARTTLS) or 465 (SSL)
SMTP_SECURE=false                     # false for STARTTLS (port 587), true for SSL (port 465)
SMTP_USER=you@gmail.com               # REQUIRED — SMTP login username
SMTP_PASSWORD=your-app-password       # REQUIRED — SMTP login password
SMTP_FROM_EMAIL=noreply@legalfilingindia.com  # OPTIONAL — defaults to SMTP_USER
SMTP_FROM_NAME=Legal Filing India     # OPTIONAL — display name in From header

# ── WhatsApp (choose one provider; leave blank if not using WhatsApp API) ────
# Provider options: web | waba | twilio | 360dialog | gupshup | interakt
# These are also configurable in Admin → Settings → WhatsApp after first launch.
WHATSAPP_PROVIDER=web
WHATSAPP_API_KEY=                     # API key / token (not needed for "web" provider)
WHATSAPP_PHONE_NUMBER_ID=             # Meta phone_number_id (WABA only)
WHATSAPP_BUSINESS_ACCOUNT_ID=        # Meta WABA id (WABA only)

# ── AI / OpenAI ──────────────────────────────────────────────────────────────
# Used for AI content generation in the blog / page editor modules.
OPENAI_API_KEY=                       # OPTIONAL — leave blank to disable AI features
OPENAI_MODEL=gpt-4o-mini              # OPTIONAL — model to use; defaults to gpt-4o-mini

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                        # OPTIONAL — trace|debug|info|warn|error|fatal

# ── Frontend (set at BUILD time, not runtime) ─────────────────────────────────
# These are baked into the static Vite bundle at build time.
VITE_API_URL=https://legalfilingindia.com/api  # OPTIONAL — if API and frontend share domain, leave blank
BASE_PATH=/                           # OPTIONAL — URL base path; "/" for root deployment
